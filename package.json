{
  "name": "www.recital-production.fr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && hack-gh-pages src/router.ts && vite-node src/bin/injectSeo.ts && vite-node src/bin/prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "createMediaFiles": "npx vite-node src/bin/generateImageUrlExports.ts",
    "postinstall": "vite-node src/bin/normalizeGalleryPhotos.ts && format-images -a src/assets/jpg -o src/assets/webp -f webp --ov true && yarn createMediaFiles",
    "prerender": "vite-node src/bin/prerender.ts"
  },
  "dependencies": {
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@mui/icons-material": "6.1.1",
    "@mui/material": "6.0.2",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^11.5.3",
    "i18nifty": "^3.2.2",
    "powerhooks": "^1.0.13",
    "react": "^18.3.1",
    "react-art-gallery": "^0.0.14",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-intersection-observer": "^9.13.1",
    "react-svg": "^16.1.34",
    "react-youtube": "^10.1.0",
    "tsafe": "^1.7.2",
    "tss-react": "^4.9.13",
    "type-route": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dir-image-converter": "^0.0.17",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "github-pages-plugin-for-type-route": "^2.0.4",
    "globals": "^15.9.0",
    "puppeteer": "^25.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-node": "^2.1.1",
    "vite-tsconfig-paths": "5.0.1"
  }
